{
  "name": "@panerelay/sites",
  "version": "0.8.0",
  "description": "Built-in site catalog for Panerelay browser-backed fetch.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F-loat/panerelay.git",
    "directory": "packages/sites"
  },
  "homepage": "https://github.com/F-loat/panerelay#readme",
  "bugs": {
    "url": "https://github.com/F-loat/panerelay/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/adapters",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node clean.mjs && tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && pnpm run test:compiled",
    "test:compiled": "node ../../scripts/run-compiled-tests.mjs dist",
    "e2e": "node --test e2e/site.e2e.test.mjs",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@panerelay/protocol": "workspace:*",
    "@panerelay/site-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  }
}
