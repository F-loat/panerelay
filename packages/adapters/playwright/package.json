{
  "name": "@panerelay/playwright",
  "version": "0.9.0",
  "description": "Connect Playwright CLI to current-tab or all-supported-tabs authorization through Panerelay.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F-loat/panerelay.git",
    "directory": "packages/adapters/playwright"
  },
  "homepage": "https://github.com/F-loat/panerelay#readme",
  "bugs": {
    "url": "https://github.com/F-loat/panerelay/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && pnpm run test:compiled",
    "test:compiled": "node ../../../scripts/run-compiled-tests.mjs dist"
  },
  "dependencies": {
    "@panerelay/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  }
}
