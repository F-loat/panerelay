{
  "name": "@panerelay/setup",
  "version": "0.1.0",
  "description": "Installer, diagnostics, and Agent integration for Panerelay.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F-loat/panerelay.git",
    "directory": "packages/setup"
  },
  "homepage": "https://github.com/F-loat/panerelay#readme",
  "bugs": {
    "url": "https://github.com/F-loat/panerelay/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "panerelay": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node ../../scripts/run-compiled-tests.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@panerelay/bridge": "workspace:*",
    "@panerelay/protocol": "workspace:*"
  }
}
