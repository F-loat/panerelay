{
  "name": "@panerelay/setup",
  "version": "0.8.0",
  "description": "Install and diagnose Panerelay's local integration and optional automation adapters.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F-loat/panerelay.git",
    "directory": "packages/setup"
  },
  "homepage": "https://github.com/F-loat/panerelay#readme",
  "bugs": {
    "url": "https://github.com/F-loat/panerelay/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "panerelay-setup": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --filter @panerelay/sites run build && node clean.mjs && tsc -p tsconfig.json && node build-private.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node ../../scripts/run-compiled-tests.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "1.2.0",
    "@panerelay/bridge": "workspace:*",
    "@panerelay/browser-registry": "workspace:*",
    "@panerelay/browser-use": "workspace:*",
    "@panerelay/playwright": "workspace:*",
    "@panerelay/cli": "workspace:*",
    "@panerelay/protocol": "workspace:*",
    "@panerelay/site-kit": "workspace:*",
    "@panerelay/sites": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
