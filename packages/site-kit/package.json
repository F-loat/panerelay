{
  "name": "@panerelay/site-kit",
  "version": "0.8.0",
  "description": "Authoring and build toolkit for Panerelay fetch site adapters.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F-loat/panerelay.git",
    "directory": "packages/site-kit"
  },
  "homepage": "https://github.com/F-loat/panerelay#readme",
  "bugs": {
    "url": "https://github.com/F-loat/panerelay/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "panerelay-site": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && pnpm run test:compiled",
    "test:compiled": "node ../../scripts/run-compiled-tests.mjs dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@panerelay/protocol": "workspace:*",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
