{
  "name": "@panerelay/bridge",
  "version": "0.7.0",
  "description": "Panerelay Native Messaging host and local browser-level CDP relay.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F-loat/panerelay.git",
    "directory": "packages/bridge"
  },
  "homepage": "https://github.com/F-loat/panerelay#readme",
  "bugs": {
    "url": "https://github.com/F-loat/panerelay/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./install": {
      "types": "./dist/host-installation.d.ts",
      "import": "./dist/host-installation.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js"
    },
    "./compatibility": {
      "types": "./dist/compatibility.d.ts",
      "import": "./dist/compatibility.js"
    },
    "./agent-browser-config": {
      "types": "./dist/agent-browser-config.d.ts",
      "import": "./dist/agent-browser-config.js"
    },
    "./browser-use-gateway": {
      "types": "./dist/browser-use-gateway.d.ts",
      "import": "./dist/browser-use-gateway.js"
    }
  },
  "bin": {
    "panerelay-bridge": "./dist/native-host.js",
    "panerelay-host-install": "./dist/install.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node clean.mjs && tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node ../../scripts/run-compiled-tests.mjs dist",
    "install:host": "pnpm run build && node dist/install.js",
    "uninstall:host": "pnpm run build && node dist/install.js --uninstall",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@panerelay/agent-browser": "workspace:*",
    "@panerelay/browser-registry": "workspace:*",
    "@panerelay/browser-use": "workspace:*",
    "@panerelay/cli": "workspace:*",
    "@panerelay/protocol": "workspace:*",
    "@panerelay/playwright": "workspace:*",
    "ws": "^8.21.1"
  },
  "devDependencies": {}
}
