+
+    pub fn new_with_url_session_and_heartbeat(
+        base_url: String,
+        session_id: String,
+        heartbeat_interval_ms: Option<u64>,
+    ) -> Result<Self, String> {
+        let parsed = url::Url::parse(&base_url)
+            .map_err(|error| format!("Invalid WebDriver URL: {}", error))?;
+        if parsed.scheme() != "http"
+            || parsed.host_str().is_none()
+            || !parsed.username().is_empty()
+            || parsed.password().is_some()
+            || parsed.query().is_some()
+            || parsed.fragment().is_some()
+        {
+            return Err("WebDriver Provider URL must be an HTTP endpoint without credentials, query, or fragment".to_string());
+        }
+        if session_id.is_empty() {
+            return Err("WebDriver Provider session ID must not be empty".to_string());
+        }
+        if heartbeat_interval_ms.is_some_and(|interval| !(10..=60_000).contains(&interval)) {
+            return Err(
+                "WebDriver Provider heartbeat interval must be from 10 through 60000 milliseconds"
+                    .to_string(),
+            );
+        }
+        let base_url = base_url.trim_end_matches('/').to_string();
+        let heartbeat_task = heartbeat_interval_ms.and_then(|interval| {
+            let heartbeat_url = format!(
+                "{}/session/{}/panerelay/heartbeat",
+                base_url,
+                urlencoding::encode(&session_id)
+            );
+            tokio::runtime::Handle::try_current().ok().map(|runtime| {
+                runtime.spawn(async move {
+                    let mut ticker = tokio::time::interval(Duration::from_millis(interval));
+                    ticker.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Delay);
+                    loop {
+                        ticker.tick().await;
+                        if http_request("GET", &heartbeat_url, None).await.is_err() {
+                            break;
+                        }
+                    }
+                })
+            })
+        });
+        Ok(Self {
+            base_url,
+            session_id: Some(session_id),
+            heartbeat_task,
+        })
+    }
